        {
          "load": {
            "entries": {},
            "epoch": "e",
            "resources": [
              {
                "id": "r1",
                "state": "live",
                "status": {
                  "state": "working"
                }
              }
            ],
            "seq": 0
          }
        },
        {
          "event": {
            "data": {
              "id": "r1",
              "state": "live",
              "status": {
                "state": "done"
              }
            },
            "epoch": "e",
            "seq": 1,
            "type": "resource"
          }
        }
      ]
    },
