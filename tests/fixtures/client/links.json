{
  "about": "Links in terminal rows (ui_model::links, core-protocol.md 'Links'). Each case gives one row of text; `expect` lists the links found, left to right: kind, text, line/column for paths, and char positions (start inclusive, end exclusive). Generated by the Rust model (tests/client_conformance.rs, VQRO_FIXTURE_UPDATE=1) and reviewed.",
  "cases": [
    {
      "expect": [
        {
          "end": 28,
          "kind": "url",
          "start": 6,
          "text": "https://example.org/zz"
        }
      ],
      "name": "a plain URL",
      "text": "visit https://example.org/zz now"
    },
    {
      "expect": [
        {
          "end": 27,
          "kind": "url",
          "start": 4,
          "text": "https://example.org/a/b"
        }
      ],
      "name": "sentence punctuation is not part of a URL",
      "text": "see https://example.org/a/b."
    },
    {
      "expect": [
        {
          "end": 22,
          "kind": "url",
          "start": 1,
          "text": "https://example.org/x"
        },
        {
          "end": 37,
          "kind": "url",
          "start": 25,
          "text": "http://x.y/z"
        }
      ],
      "name": "brackets around a URL",
      "text": "(https://example.org/x) [http://x.y/z]"
    },
    {
      "expect": [
        {
          "end": 57,
          "kind": "url",
          "start": 0,
          "text": "https://en.wikipedia.org/wiki/Rust_(programming_language)"
        }
      ],
      "name": "balanced brackets inside a URL stay",
      "text": "https://en.wikipedia.org/wiki/Rust_(programming_language)"
    },
    {
      "expect": [
        {
          "end": 37,
          "kind": "url",
          "start": 8,
          "text": "https://example.org/q?x=1&y=2"
        }
      ],
      "name": "a URL after href=",
      "text": "<a href=https://example.org/q?x=1&y=2>"
    },
    {
      "expect": [
        {
          "end": 22,
          "kind": "url",
          "start": 1,
          "text": "https://example.org/a"
        },
        {
          "end": 37,
          "kind": "url",
          "start": 25,
          "text": "http://b.c/d"
        }
      ],
      "name": "quotes end a URL",
      "text": "'https://example.org/a' \"http://b.c/d\""
    },
    {
      "expect": [],
      "name": "a scheme alone is not a link",
      "text": "https:// is a prefix"
    },
    {
      "expect": [
        {
          "column": 5,
          "end": 25,
          "kind": "path",
          "line": 12,
          "start": 9,
          "text": "src/main.rs"
        }
      ],
      "name": "a compiler location",
      "text": "error at src/main.rs:12:5: oops"
    },
    {
      "expect": [
        {
          "end": 14,
          "kind": "path",
          "start": 4,
          "text": "/etc/hosts"
        }
      ],
      "name": "an absolute path",
      "text": "cat /etc/hosts"
    },
    {
      "expect": [
        {
          "end": 10,
          "kind": "path",
          "start": 0,
          "text": "~/notes.md"
        },
        {
          "end": 19,
          "kind": "path",
          "start": 11,
          "text": "./run.sh"
        },
        {
          "end": 30,
          "kind": "path",
          "start": 20,
          "text": "../x/y.txt"
        }
      ],
      "name": "home and relative paths",
      "text": "~/notes.md ./run.sh ../x/y.txt"
    },
    {
      "expect": [
        {
          "end": 10,
          "kind": "path",
          "line": 42,
          "start": 0,
          "text": "main.rs"
        }
      ],
      "name": "a bare file name with a line",
      "text": "main.rs:42 failed"
    },
    {
      "expect": [],
      "name": "a bare file name without a line is not a path",
      "text": "edit main.rs please"
    },
    {
      "expect": [
        {
          "end": 27,
          "kind": "path",
          "start": 6,
          "text": "/usr/lib/python3/x.py"
        }
      ],
      "name": "a quoted path from a Python traceback",
      "text": "File \"/usr/lib/python3/x.py\", line 12"
    },
    {
      "expect": [],
      "name": "slashes alone are not a path",
      "text": "// comment and / divide"
    },
    {
      "expect": [
        {
          "end": 14,
          "kind": "path",
          "start": 7,
          "text": "a/b.txt"
        },
        {
          "end": 23,
          "kind": "path",
          "start": 16,
          "text": "c/d.txt"
        }
      ],
      "name": "trailing comma and colon",
      "text": "files: a/b.txt, c/d.txt:"
    },
    {
      "expect": [
        {
          "end": 14,
          "kind": "url",
          "start": 0,
          "text": "https://a.io/x"
        },
        {
          "end": 30,
          "kind": "path",
          "line": 3,
          "start": 20,
          "text": "lib/x.rs"
        },
        {
          "end": 47,
          "kind": "url",
          "start": 35,
          "text": "https://b.io"
        }
      ],
      "name": "several links in one row",
      "text": "https://a.io/x then lib/x.rs:3 and https://b.io"
    },
    {
      "expect": [
        {
          "end": 25,
          "kind": "url",
          "start": 3,
          "text": "https://example.org/中文"
        }
      ],
      "name": "wide characters before a link count as one char each",
      "text": "说明 https://example.org/中文"
    }
  ]
}
