{
  "about": "The finish a resource update reaches (ui_model::tabbar::reached): `old` is the record before the update (null when new), `new` the record after; `expect` is done, error or null. Clients latch it from every resource event until the tab is shown. Generated by the Rust model and reviewed.",
  "cases": [
    {
      "expect": "done",
      "name": "working to done",
      "new": {
        "id": "r1",
        "status": {
          "state": "done"
        }
      },
      "old": {
        "id": "r1",
        "status": {
          "state": "working"
        }
      }
    },
    {
      "expect": "error",
      "name": "blocked to error",
      "new": {
        "id": "r1",
        "status": {
          "state": "error"
        }
      },
      "old": {
        "id": "r1",
        "status": {
          "state": "blocked"
        }
      }
    },
    {
      "expect": null,
      "name": "done again is no new finish",
      "new": {
        "id": "r1",
        "status": {
          "state": "done"
        }
      },
      "old": {
        "id": "r1",
        "status": {
          "state": "done"
        }
      }
    },
    {
      "expect": "done",
      "name": "first sight of done (no record before)",
      "new": {
        "id": "r1",
        "status": {
          "state": "done"
        }
      },
      "old": null
    },
    {
      "expect": null,
      "name": "done to cleared is no finish",
      "new": {
        "id": "r1",
        "status": null
      },
      "old": {
        "id": "r1",
        "status": {
          "state": "done"
        }
      }
    },
    {
      "expect": null,
      "name": "working to blocked is no finish",
      "new": {
        "id": "r1",
        "status": {
          "state": "blocked"
        }
      },
      "old": {
        "id": "r1",
        "status": {
          "state": "working"
        }
      }
    }
  ]
}
