{"comment": "Shared item-stream viewer vectors (agent-v0 section 4) for the Rust ItemView and Python vqro_items.ItemView: each case feeds `snapshot` (once installed, seq 0) then `records`, and expects seq, records (live records applied), broken and the non-zero error counts. Default bounds."}
{"name": "text append applies", "snapshot": [{"op": "snapshot", "phase": "begin", "epoch": "e1", "coverage": "all_retained"}, {"op": "put", "kind": "message", "id": "m1", "rev": 1, "value": {"c": ["a", "b"], "t": "x", "raw": ""}}, {"op": "snapshot", "phase": "end", "seq": 0}], "records": [{"op": "append", "seq": 1, "kind": "message", "id": "m1", "base": 1, "rev": 2, "field": "/t", "text": "y"}], "expect": {"seq": 1, "records": 1, "broken": false, "errors": {}}}
{"name": "list index applies", "snapshot": [{"op": "snapshot", "phase": "begin", "epoch": "e1", "coverage": "all_retained"}, {"op": "put", "kind": "message", "id": "m1", "rev": 1, "value": {"c": ["a", "b"], "t": "x", "raw": ""}}, {"op": "snapshot", "phase": "end", "seq": 0}], "records": [{"op": "append", "seq": 1, "kind": "message", "id": "m1", "base": 1, "rev": 2, "field": "/c/1", "text": "!"}], "expect": {"seq": 1, "records": 1, "broken": false, "errors": {}}}
{"name": "bytes append applies", "snapshot": [{"op": "snapshot", "phase": "begin", "epoch": "e1", "coverage": "all_retained"}, {"op": "put", "kind": "message", "id": "m1", "rev": 1, "value": {"c": ["a", "b"], "t": "x", "raw": ""}}, {"op": "snapshot", "phase": "end", "seq": 0}], "records": [{"op": "append", "seq": 1, "kind": "message", "id": "m1", "base": 1, "rev": 2, "field": "/raw", "bytes": "AA=="}], "expect": {"seq": 1, "records": 1, "broken": false, "errors": {}}}
{"name": "missing seq is a loss", "snapshot": [{"op": "snapshot", "phase": "begin", "epoch": "e1", "coverage": "all_retained"}, {"op": "put", "kind": "message", "id": "m1", "rev": 1, "value": {"c": ["a", "b"], "t": "x", "raw": ""}}, {"op": "snapshot", "phase": "end", "seq": 0}], "records": [{"op": "append", "seq": 2, "kind": "message", "id": "m1", "base": 1, "rev": 2, "field": "/t", "text": "y"}], "expect": {"seq": 0, "records": 0, "broken": true, "errors": {"missing": 1}}}
{"name": "duplicate is ignored", "snapshot": [{"op": "snapshot", "phase": "begin", "epoch": "e1", "coverage": "all_retained"}, {"op": "put", "kind": "message", "id": "m1", "rev": 1, "value": {"c": ["a", "b"], "t": "x", "raw": ""}}, {"op": "snapshot", "phase": "end", "seq": 0}], "records": [{"op": "append", "seq": 1, "kind": "message", "id": "m1", "base": 1, "rev": 2, "field": "/t", "text": "y"}, {"op": "append", "seq": 1, "kind": "message", "id": "m1", "base": 1, "rev": 2, "field": "/t", "text": "y"}], "expect": {"seq": 1, "records": 1, "broken": false, "errors": {"duplicate": 1}}}
{"name": "stale base", "snapshot": [{"op": "snapshot", "phase": "begin", "epoch": "e1", "coverage": "all_retained"}, {"op": "put", "kind": "message", "id": "m1", "rev": 1, "value": {"c": ["a", "b"], "t": "x", "raw": ""}}, {"op": "snapshot", "phase": "end", "seq": 0}], "records": [{"op": "append", "seq": 1, "kind": "message", "id": "m1", "base": 7, "rev": 8, "field": "/t", "text": "y"}], "expect": {"seq": 0, "records": 0, "broken": true, "errors": {"stale_base": 1}}}
{"name": "float base is not a revision", "snapshot": [{"op": "snapshot", "phase": "begin", "epoch": "e1", "coverage": "all_retained"}, {"op": "put", "kind": "message", "id": "m1", "rev": 1, "value": {"c": ["a", "b"], "t": "x", "raw": ""}}, {"op": "snapshot", "phase": "end", "seq": 0}], "records": [{"op": "append", "seq": 1, "kind": "message", "id": "m1", "base": 1.0, "rev": 2, "field": "/t", "text": "y"}], "expect": {"seq": 0, "records": 0, "broken": true, "errors": {"stale_base": 1}}}
{"name": "unicode digit index", "snapshot": [{"op": "snapshot", "phase": "begin", "epoch": "e1", "coverage": "all_retained"}, {"op": "put", "kind": "message", "id": "m1", "rev": 1, "value": {"c": ["a", "b"], "t": "x", "raw": ""}}, {"op": "snapshot", "phase": "end", "seq": 0}], "records": [{"op": "append", "seq": 1, "kind": "message", "id": "m1", "base": 1, "rev": 2, "field": "/c/²", "text": "y"}], "expect": {"seq": 0, "records": 0, "broken": true, "errors": {"bad_record": 1}}}
{"name": "leading zero index", "snapshot": [{"op": "snapshot", "phase": "begin", "epoch": "e1", "coverage": "all_retained"}, {"op": "put", "kind": "message", "id": "m1", "rev": 1, "value": {"c": ["a", "b"], "t": "x", "raw": ""}}, {"op": "snapshot", "phase": "end", "seq": 0}], "records": [{"op": "append", "seq": 1, "kind": "message", "id": "m1", "base": 1, "rev": 2, "field": "/c/01", "text": "y"}], "expect": {"seq": 0, "records": 0, "broken": true, "errors": {"bad_record": 1}}}
{"name": "plus sign index", "snapshot": [{"op": "snapshot", "phase": "begin", "epoch": "e1", "coverage": "all_retained"}, {"op": "put", "kind": "message", "id": "m1", "rev": 1, "value": {"c": ["a", "b"], "t": "x", "raw": ""}}, {"op": "snapshot", "phase": "end", "seq": 0}], "records": [{"op": "append", "seq": 1, "kind": "message", "id": "m1", "base": 1, "rev": 2, "field": "/c/+1", "text": "y"}], "expect": {"seq": 0, "records": 0, "broken": true, "errors": {"bad_record": 1}}}
{"name": "index past the end", "snapshot": [{"op": "snapshot", "phase": "begin", "epoch": "e1", "coverage": "all_retained"}, {"op": "put", "kind": "message", "id": "m1", "rev": 1, "value": {"c": ["a", "b"], "t": "x", "raw": ""}}, {"op": "snapshot", "phase": "end", "seq": 0}], "records": [{"op": "append", "seq": 1, "kind": "message", "id": "m1", "base": 1, "rev": 2, "field": "/c/2", "text": "y"}], "expect": {"seq": 0, "records": 0, "broken": true, "errors": {"bad_record": 1}}}
{"name": "field names a non-string", "snapshot": [{"op": "snapshot", "phase": "begin", "epoch": "e1", "coverage": "all_retained"}, {"op": "put", "kind": "message", "id": "m1", "rev": 1, "value": {"c": ["a", "b"], "t": "x", "raw": ""}}, {"op": "snapshot", "phase": "end", "seq": 0}], "records": [{"op": "append", "seq": 1, "kind": "message", "id": "m1", "base": 1, "rev": 2, "field": "/c", "text": "y"}], "expect": {"seq": 0, "records": 0, "broken": true, "errors": {"bad_record": 1}}}
{"name": "missing field", "snapshot": [{"op": "snapshot", "phase": "begin", "epoch": "e1", "coverage": "all_retained"}, {"op": "put", "kind": "message", "id": "m1", "rev": 1, "value": {"c": ["a", "b"], "t": "x", "raw": ""}}, {"op": "snapshot", "phase": "end", "seq": 0}], "records": [{"op": "append", "seq": 1, "kind": "message", "id": "m1", "base": 1, "rev": 2, "text": "y"}], "expect": {"seq": 0, "records": 0, "broken": true, "errors": {"bad_record": 1}}}
{"name": "both payload keys", "snapshot": [{"op": "snapshot", "phase": "begin", "epoch": "e1", "coverage": "all_retained"}, {"op": "put", "kind": "message", "id": "m1", "rev": 1, "value": {"c": ["a", "b"], "t": "x", "raw": ""}}, {"op": "snapshot", "phase": "end", "seq": 0}], "records": [{"op": "append", "seq": 1, "kind": "message", "id": "m1", "base": 1, "rev": 2, "field": "/t", "text": "y", "bytes": "AA=="}], "expect": {"seq": 0, "records": 0, "broken": true, "errors": {"bad_record": 1}}}
{"name": "text with null bytes key", "snapshot": [{"op": "snapshot", "phase": "begin", "epoch": "e1", "coverage": "all_retained"}, {"op": "put", "kind": "message", "id": "m1", "rev": 1, "value": {"c": ["a", "b"], "t": "x", "raw": ""}}, {"op": "snapshot", "phase": "end", "seq": 0}], "records": [{"op": "append", "seq": 1, "kind": "message", "id": "m1", "base": 1, "rev": 2, "field": "/t", "text": "y", "bytes": null}], "expect": {"seq": 0, "records": 0, "broken": true, "errors": {"bad_record": 1}}}
{"name": "neither payload", "snapshot": [{"op": "snapshot", "phase": "begin", "epoch": "e1", "coverage": "all_retained"}, {"op": "put", "kind": "message", "id": "m1", "rev": 1, "value": {"c": ["a", "b"], "t": "x", "raw": ""}}, {"op": "snapshot", "phase": "end", "seq": 0}], "records": [{"op": "append", "seq": 1, "kind": "message", "id": "m1", "base": 1, "rev": 2, "field": "/t"}], "expect": {"seq": 0, "records": 0, "broken": true, "errors": {"bad_record": 1}}}
{"name": "bad base64", "snapshot": [{"op": "snapshot", "phase": "begin", "epoch": "e1", "coverage": "all_retained"}, {"op": "put", "kind": "message", "id": "m1", "rev": 1, "value": {"c": ["a", "b"], "t": "x", "raw": ""}}, {"op": "snapshot", "phase": "end", "seq": 0}], "records": [{"op": "append", "seq": 1, "kind": "message", "id": "m1", "base": 1, "rev": 2, "field": "/raw", "bytes": "!!"}], "expect": {"seq": 0, "records": 0, "broken": true, "errors": {"bad_record": 1}}}
{"name": "append to unknown entity", "snapshot": [{"op": "snapshot", "phase": "begin", "epoch": "e1", "coverage": "all_retained"}, {"op": "put", "kind": "message", "id": "m1", "rev": 1, "value": {"c": ["a", "b"], "t": "x", "raw": ""}}, {"op": "snapshot", "phase": "end", "seq": 0}], "records": [{"op": "append", "seq": 1, "kind": "message", "id": "zz", "base": 1, "rev": 2, "field": "/t", "text": "y"}], "expect": {"seq": 0, "records": 0, "broken": true, "errors": {"unknown_entity": 1}}}
{"name": "remove unknown advances", "snapshot": [{"op": "snapshot", "phase": "begin", "epoch": "e1", "coverage": "all_retained"}, {"op": "put", "kind": "message", "id": "m1", "rev": 1, "value": {"c": ["a", "b"], "t": "x", "raw": ""}}, {"op": "snapshot", "phase": "end", "seq": 0}], "records": [{"op": "remove", "seq": 1, "kind": "message", "id": "zz", "rev": 1}], "expect": {"seq": 1, "records": 1, "broken": true, "errors": {"unknown_entity": 1}}}
{"name": "unknown op", "snapshot": [{"op": "snapshot", "phase": "begin", "epoch": "e1", "coverage": "all_retained"}, {"op": "put", "kind": "message", "id": "m1", "rev": 1, "value": {"c": ["a", "b"], "t": "x", "raw": ""}}, {"op": "snapshot", "phase": "end", "seq": 0}], "records": [{"op": "frobnicate", "seq": 1, "kind": "message", "id": "m1", "rev": 2}], "expect": {"seq": 0, "records": 0, "broken": true, "errors": {"bad_record": 1}}}
{"name": "malformed envelope", "snapshot": [{"op": "snapshot", "phase": "begin", "epoch": "e1", "coverage": "all_retained"}, {"op": "put", "kind": "message", "id": "m1", "rev": 1, "value": {"c": ["a", "b"], "t": "x", "raw": ""}}, {"op": "snapshot", "phase": "end", "seq": 0}], "records": [{"op": "put", "seq": 1, "kind": "message", "id": 7, "rev": 1, "value": {}}], "expect": {"seq": 0, "records": 0, "broken": true, "errors": {"bad_record": 1}}}
{"name": "nothing applies after a loss", "snapshot": [{"op": "snapshot", "phase": "begin", "epoch": "e1", "coverage": "all_retained"}, {"op": "put", "kind": "message", "id": "m1", "rev": 1, "value": {"c": ["a", "b"], "t": "x", "raw": ""}}, {"op": "snapshot", "phase": "end", "seq": 0}], "records": [{"op": "append", "seq": 2, "kind": "message", "id": "m1", "base": 1, "rev": 2, "field": "/t", "text": "y"}, {"op": "append", "seq": 1, "kind": "message", "id": "m1", "base": 1, "rev": 2, "field": "/t", "text": "z"}], "expect": {"seq": 0, "records": 0, "broken": true, "errors": {"missing": 1}}}
