{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vqro:work-contract:v1",
  "title": "V1 extension-owned work contract candidate",
  "description": "Schema candidate, not host API availability. UTF-8 byte quotas, actor authority, graph/CAS and digest equality require semantic validation.",
  "oneOf": [{"$ref":"#/$defs/actor"},{"$ref":"#/$defs/caller"},{"$ref":"#/$defs/task"},{"$ref":"#/$defs/thread"},{"$ref":"#/$defs/action"},{"$ref":"#/$defs/query"},{"$ref":"#/$defs/readResult"},{"$ref":"#/$defs/entry"},{"$ref":"#/$defs/receipt"},{"$ref":"#/$defs/receiptMissing"}],
  "$defs": {
    "id": {"type":"string","minLength":1,"maxLength":128,"pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "revision": {"type":"string","maxLength":20,"pattern":"^(0|[1-9][0-9]*)$","description":"Semantic upper bound uint64; never JSON number."},
    "digest": {"type":"string","pattern":"^[a-f0-9]{64}$"},
    "text": {"type":"string","maxLength":32768,"pattern":"^[^\u0000-\u0008\u000b\u000c\u000e-\u001f\u007f]*$","description":"Also <=32768 UTF-8 bytes; text only, no terminal control interpretation."},
    "refRevision": {"type":"object","additionalProperties":false,"required":["id","revision"],"properties":{"id":{"$ref":"#/$defs/id"},"revision":{"$ref":"#/$defs/revision"}}},
    "preconditions": {"type":"object","additionalProperties":false,"description":"Semantic validation requires every affected ref, unique IDs and current versions; arrays cannot bypass CAS.","required":["store_id","store_generation","tasks","threads"],"properties":{"store_id":{"$ref":"#/$defs/id"},"store_generation":{"$ref":"#/$defs/revision"},"tasks":{"type":"array","maxItems":256,"items":{"$ref":"#/$defs/refRevision"}},"threads":{"type":"array","maxItems":256,"items":{"$ref":"#/$defs/refRevision"}}}},
    "actor": {
      "type":"object","additionalProperties":false,"required":["contract","actor_id","class","principal_id","execution","assurance","availability"],
      "properties":{"contract":{"const":"vqro.work.actor.v1"},"actor_id":{"$ref":"#/$defs/id"},"class":{"enum":["human","agent","service"]},"principal_id":{"$ref":"#/$defs/id"},"execution":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/execution"}]},"assurance":{"enum":["user_authorized_binding","service_principal"]},"availability":{"enum":["available","offline","unknown","retired"]}}
    },
    "execution": {"type":"object","additionalProperties":false,"required":["execution_id","epoch","session_trust"],"properties":{"execution_id":{"$ref":"#/$defs/id"},"epoch":{"$ref":"#/$defs/revision"},"session_trust":{"enum":["managed","reported","unknown"]}}},
    "caller": {
      "type":"object","additionalProperties":false,"required":["contract","server_id","boot_id","principal_id","principal_kind","actor_id","execution","namespace","service_id","provider_generation","operation_id","input_digest","invocation_id","budget_ms","capabilities"],
      "properties":{"contract":{"const":"vqro.caller-context.v1"},"server_id":{"$ref":"#/$defs/id"},"boot_id":{"$ref":"#/$defs/id"},"principal_id":{"$ref":"#/$defs/id"},"principal_kind":{"enum":["client","service"]},"actor_id":{"$ref":"#/$defs/id"},"execution":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/execution"}]},"namespace":{"type":"string","maxLength":128,"pattern":"^[a-z0-9_-]+(?:\\.[a-z0-9_-]+)+$"},"service_id":{"$ref":"#/$defs/id"},"provider_generation":{"$ref":"#/$defs/revision"},"operation_id":{"$ref":"#/$defs/id"},"input_digest":{"$ref":"#/$defs/digest"},"invocation_id":{"$ref":"#/$defs/id"},"budget_ms":{"type":"integer","minimum":1,"maximum":60000},"capabilities":{"type":"array","maxItems":32,"uniqueItems":true,"items":{"type":"string","maxLength":128}}}
    },
    "action": {
      "type":"object","additionalProperties":false,"required":["contract","action","operation_id","preconditions","params"],
      "properties":{"contract":{"const":"vqro.work.action.v1"},"operation_id":{"$ref":"#/$defs/id"},"preconditions":{"$ref":"#/$defs/preconditions"},"action":{"enum":["work.task.create.v1","work.task.assign.v1","work.entry.post.v1","work.entry.reply.v1","work.report.propose.v1","work.report.accept.v1","work.report.reject.v1","work.resume.v1","work.output.route.v1","work.proposal.confirm.v1","work.decision.override.v1"]},"params":{"type":"object"}},
      "allOf":[
        {"if":{"properties":{"action":{"const":"work.task.create.v1"}}},"then":{"properties":{"params":{"$ref":"#/$defs/create"}}}},
        {"if":{"properties":{"action":{"const":"work.task.assign.v1"}}},"then":{"properties":{"params":{"$ref":"#/$defs/assign"}}}},
        {"if":{"properties":{"action":{"const":"work.entry.post.v1"}}},"then":{"properties":{"params":{"$ref":"#/$defs/post"}}}},
        {"if":{"properties":{"action":{"const":"work.entry.reply.v1"}}},"then":{"properties":{"params":{"$ref":"#/$defs/reply"}}}},
        {"if":{"properties":{"action":{"const":"work.report.propose.v1"}}},"then":{"properties":{"params":{"$ref":"#/$defs/report"}}}},
        {"if":{"properties":{"action":{"enum":["work.report.accept.v1","work.report.reject.v1"]}}},"then":{"properties":{"params":{"$ref":"#/$defs/accept"}}}},
        {"if":{"properties":{"action":{"const":"work.resume.v1"}}},"then":{"properties":{"params":{"$ref":"#/$defs/resume"}}}},
        {"if":{"properties":{"action":{"const":"work.proposal.confirm.v1"}}},"then":{"properties":{"params":{"$ref":"#/$defs/confirm"}}}},
        {"if":{"properties":{"action":{"const":"work.output.route.v1"}}},"then":{"properties":{"params":{"$ref":"#/$defs/outputRoute"}}}},
        {"if":{"properties":{"action":{"const":"work.decision.override.v1"}}},"then":{"properties":{"params":{"$ref":"#/$defs/override"}}}}
      ]
    },
    "create": {"type":"object","additionalProperties":false,"required":["parent_task_id","title","body"],"properties":{"parent_task_id":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/id"}]},"title":{"type":"string","minLength":1,"maxLength":240,"pattern":"^[^\u0000-\u001f\u007f]*$"},"body":{"$ref":"#/$defs/text"}}},
    "assign": {"type":"object","additionalProperties":false,"required":["task_id","recipient_actor_id","body"],"properties":{"task_id":{"$ref":"#/$defs/id"},"recipient_actor_id":{"$ref":"#/$defs/id"},"body":{"$ref":"#/$defs/text"}}},
    "post": {"type":"object","additionalProperties":false,"required":["task_id","thread_id","parent_entry_id","kind","recipient_actor_id","body"],"properties":{"task_id":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/id"}]},"thread_id":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/id"}]},"parent_entry_id":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/id"}]},"kind":{"enum":["message","question","block"]},"recipient_actor_id":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/id"}]},"body":{"$ref":"#/$defs/text"}}},
    "reply": {"type":"object","additionalProperties":false,"required":["task_id","thread_id","source_entry_id","source_entry_version","recipient_actor_id","run_id","body"],"properties":{"task_id":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/id"}]},"thread_id":{"$ref":"#/$defs/id"},"source_entry_id":{"$ref":"#/$defs/id"},"source_entry_version":{"$ref":"#/$defs/revision"},"recipient_actor_id":{"$ref":"#/$defs/id"},"run_id":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/id"}]},"body":{"$ref":"#/$defs/text"}}},
    "report": {"type":"object","additionalProperties":false,"required":["task_id","thread_id","source_entry_id","body","evidence"],"properties":{"task_id":{"$ref":"#/$defs/id"},"thread_id":{"$ref":"#/$defs/id"},"source_entry_id":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/id"}]},"body":{"$ref":"#/$defs/text"},"evidence":{"type":"array","maxItems":16,"items":{"$ref":"#/$defs/evidence"}}}},
    "evidence": {"type":"object","additionalProperties":false,"required":["label","uri","sha256"],"properties":{"label":{"type":"string","maxLength":240},"uri":{"type":"string","maxLength":2048},"sha256":{"$ref":"#/$defs/digest"}},"description":"Display/reference only, no automatic file/network access."},
    "accept": {"type":"object","additionalProperties":false,"required":["task_id","report_entry_id","reason"],"properties":{"task_id":{"$ref":"#/$defs/id"},"report_entry_id":{"$ref":"#/$defs/id"},"reason":{"$ref":"#/$defs/text"}}},
    "resume": {"type":"object","additionalProperties":false,"required":["task_id","execution_id","observed_revision","reason"],"properties":{"task_id":{"$ref":"#/$defs/id"},"execution_id":{"$ref":"#/$defs/id"},"observed_revision":{"$ref":"#/$defs/revision"},"reason":{"$ref":"#/$defs/text"}}},
    "outputRoute": {"type":"object","additionalProperties":false,"required":["task_id","thread_id","source_entry_id","source_entry_version","execution_id","execution_epoch","run_id","expected_route_revision","route","recipient_actor_id","reason"],"properties":{"task_id":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/id"}]},"thread_id":{"$ref":"#/$defs/id"},"source_entry_id":{"$ref":"#/$defs/id"},"source_entry_version":{"$ref":"#/$defs/revision"},"execution_id":{"$ref":"#/$defs/id"},"execution_epoch":{"$ref":"#/$defs/revision"},"run_id":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/id"}]},"expected_route_revision":{"$ref":"#/$defs/revision"},"route":{"enum":["thread_reply","explicit_human","cancel"]},"recipient_actor_id":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/id"}]},"reason":{"$ref":"#/$defs/text"}},"allOf":[{"if":{"properties":{"route":{"const":"explicit_human"}}},"then":{"properties":{"recipient_actor_id":{"$ref":"#/$defs/id"}}},"else":{"properties":{"recipient_actor_id":{"type":"null"}}}}],"description":"Human-only consent/CAS. Null run permitted only when authoritative receipt proves no run; then exact first host run for source+execution consumes grant once. Verified recipient identity/class/availability and exact source task required."},
    "confirm": {"type":"object","additionalProperties":false,"required":["proposal_id","input_revision","chosen_action","reason"],"properties":{"proposal_id":{"$ref":"#/$defs/id"},"input_revision":{"$ref":"#/$defs/revision"},"chosen_action":{"allOf":[{"$ref":"#/$defs/action"},{"properties":{"action":{"not":{"enum":["work.proposal.confirm.v1","work.decision.override.v1"]}}}}]},"reason":{"$ref":"#/$defs/text"}}},
    "override": {"type":"object","additionalProperties":false,"required":["decision_id","point","input_revision","replacement","reason"],"properties":{"decision_id":{"$ref":"#/$defs/id"},"point":{"type":"string","maxLength":128},"input_revision":{"$ref":"#/$defs/revision"},"replacement":{"type":"object"},"reason":{"$ref":"#/$defs/text"}}},
    "task": {"type":"object","additionalProperties":false,"required":["contract","task_id","parent_task_id","revision","title","state","creator_actor_id","assigned_actor_id","participants"],"properties":{"contract":{"const":"vqro.work.task.v1"},"task_id":{"$ref":"#/$defs/id"},"parent_task_id":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/id"}]},"revision":{"$ref":"#/$defs/revision"},"title":{"type":"string","minLength":1,"maxLength":240},"state":{"enum":["active","blocked","reported","accepted","rejected","archived"]},"creator_actor_id":{"$ref":"#/$defs/id"},"assigned_actor_id":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/id"}]},"participants":{"type":"array","maxItems":256,"uniqueItems":true,"items":{"$ref":"#/$defs/id"}}}},
    "thread": {"type":"object","additionalProperties":false,"required":["contract","thread_id","task_id","root_entry_id","revision","participants"],"properties":{"contract":{"const":"vqro.work.thread.v1"},"thread_id":{"$ref":"#/$defs/id"},"task_id":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/id"}]},"root_entry_id":{"$ref":"#/$defs/id"},"revision":{"$ref":"#/$defs/revision"},"participants":{"type":"array","maxItems":256,"uniqueItems":true,"items":{"$ref":"#/$defs/id"}}}},
    "readCursor": {"type":"object","additionalProperties":false,"required":["store_id","store_generation","snapshot_revision","after_sequence"],"properties":{"store_id":{"$ref":"#/$defs/id"},"store_generation":{"$ref":"#/$defs/revision"},"snapshot_revision":{"$ref":"#/$defs/revision"},"after_sequence":{"$ref":"#/$defs/revision"}}},
    "query": {"type":"object","additionalProperties":false,"required":["contract","action","params"],"properties":{"contract":{"const":"vqro.work.query.v1"},"action":{"enum":["work.read.v1","work.receipt.get.v1"]},"params":{"type":"object"}},"allOf":[{"if":{"properties":{"action":{"const":"work.read.v1"}}},"then":{"properties":{"params":{"type":"object","additionalProperties":false,"required":["task_id","thread_id","after_cursor","limit"],"properties":{"task_id":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/id"}]},"thread_id":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/id"}]},"after_cursor":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/readCursor"}]},"limit":{"type":"integer","minimum":1,"maximum":128}}}}}},{"if":{"properties":{"action":{"const":"work.receipt.get.v1"}}},"then":{"properties":{"params":{"type":"object","additionalProperties":false,"required":["original_actor_id","operation_id","expected_lookup_domain"],"properties":{"expected_lookup_domain":{"type":"object","additionalProperties":false,"required":["store_id","store_generation"],"properties":{"store_id":{"$ref":"#/$defs/id"},"store_generation":{"$ref":"#/$defs/revision"}}},"original_actor_id":{"$ref":"#/$defs/id"},"operation_id":{"$ref":"#/$defs/id"}}}}}}]},
    "routeAuthorization": {"type":"object","additionalProperties":false,"required":["authorization_id","task_id","thread_id","source_entry_id","source_entry_version","execution_id","execution_epoch","run_id","route_revision","route","recipient_actor_id","author_actor_id","state"],"properties":{"authorization_id":{"$ref":"#/$defs/id"},"task_id":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/id"}]},"thread_id":{"$ref":"#/$defs/id"},"source_entry_id":{"$ref":"#/$defs/id"},"source_entry_version":{"$ref":"#/$defs/revision"},"execution_id":{"$ref":"#/$defs/id"},"execution_epoch":{"$ref":"#/$defs/revision"},"run_id":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/id"}]},"route_revision":{"$ref":"#/$defs/revision"},"route":{"enum":["thread_reply","explicit_human","cancel"]},"recipient_actor_id":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/id"}]},"author_actor_id":{"$ref":"#/$defs/id"},"state":{"enum":["authorized","cancelled","consumed"]}}},
    "readResult": {"type":"object","additionalProperties":false,"required":["contract","store_id","store_generation","snapshot_revision","next_cursor","tasks","threads","entries","route_authorizations"],"properties":{"contract":{"const":"vqro.work.read.result.v1"},"store_id":{"$ref":"#/$defs/id"},"store_generation":{"$ref":"#/$defs/revision"},"snapshot_revision":{"$ref":"#/$defs/revision"},"next_cursor":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/readCursor"}]},"tasks":{"type":"array","maxItems":128,"items":{"$ref":"#/$defs/task"}},"threads":{"type":"array","maxItems":128,"items":{"$ref":"#/$defs/thread"}},"entries":{"type":"array","maxItems":128,"items":{"$ref":"#/$defs/entry"}},"route_authorizations":{"type":"array","maxItems":128,"items":{"$ref":"#/$defs/routeAuthorization"}}},"description":"<=128 total returned records across arrays and <=64KiB JSON; scope-filtered by immutable caller. Pagination bound to store generation/snapshot."},
    "entry": {
      "type":"object","additionalProperties":false,"required":["contract","entry_id","entry_version","thread_id","parent_entry_id","task_id","kind","author_actor_id","producer_principal_id","recipient_actor_id","body","evidence","operation_id","cursor"],
      "properties":{"contract":{"const":"vqro.work.entry.v1"},"entry_id":{"$ref":"#/$defs/id"},"entry_version":{"const":"1"},"thread_id":{"$ref":"#/$defs/id"},"parent_entry_id":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/id"}]},"task_id":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/id"}]},"kind":{"enum":["message","assign","question","reply","report","accept","reject","block","resume","link","override"]},"author_actor_id":{"$ref":"#/$defs/id"},"producer_principal_id":{"$ref":"#/$defs/id"},"recipient_actor_id":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/id"}]},"body":{"$ref":"#/$defs/text"},"evidence":{"type":"array","maxItems":16,"items":{"$ref":"#/$defs/evidence"}},"proposed_by_actor_id":{"$ref":"#/$defs/id"},"operation_id":{"$ref":"#/$defs/id"},"cursor":{"$ref":"#/$defs/commit"}}
    },
    "commit": {"type":"object","additionalProperties":false,"required":["store_id","store_generation","sequence","record_id","digest"],"properties":{"store_id":{"$ref":"#/$defs/id"},"store_generation":{"$ref":"#/$defs/revision"},"sequence":{"$ref":"#/$defs/revision"},"record_id":{"$ref":"#/$defs/id"},"digest":{"$ref":"#/$defs/digest"}}},
    "receiptMissing": {"type":"object","additionalProperties":false,"required":["state","lookup_key","lookup_domain","assurance"],"properties":{"state":{"enum":["absent","unknown","retired","repair_required"]},"lookup_key":{"type":"object","additionalProperties":false,"required":["namespace","original_actor_id","operation_id"],"properties":{"namespace":{"type":"string","maxLength":128},"original_actor_id":{"$ref":"#/$defs/id"},"operation_id":{"$ref":"#/$defs/id"}}},"lookup_domain":{"type":"object","additionalProperties":false,"required":["store_id","store_generation"],"properties":{"store_id":{"$ref":"#/$defs/id"},"store_generation":{"$ref":"#/$defs/revision"}}},"assurance":{"enum":["authoritative_absent","not_authoritative"]}},"allOf":[{"if":{"properties":{"state":{"const":"absent"}}},"then":{"properties":{"assurance":{"const":"authoritative_absent"}}},"else":{"properties":{"assurance":{"const":"not_authoritative"}}}}]},
    "receipt": {
      "type":"object","additionalProperties":false,"required":["contract","actor_id","operation_id","input_digest","stage","effect","commit","delivery_id","assurance"],
      "properties":{"contract":{"const":"vqro.work.receipt.v1"},"actor_id":{"$ref":"#/$defs/id"},"operation_id":{"$ref":"#/$defs/id"},"input_digest":{"$ref":"#/$defs/digest"},"effect":{"enum":["no_effect","proposal_only","applied","unknown"]},"stage":{"enum":["admitted","committed","pending_delivery","enqueued","claimed","run_started","reply_committed","report_committed","accepted","rejected","conflict","unknown","retired","repair_required"]},"commit":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/commit"}]},"delivery_id":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/id"}]},"assurance":{"enum":["host_journal","provider_claim","unknown"]}},
      "description":"Semantic validation: consequential applied stages require host_journal evidence; provider_claim is not a durable commit. Stages are observations, not a total linear ordering."
    }
  }
}
