{
  "$id": "https://vqro.dev/schema/host-terminals/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "availability": "staged; production package activation is not enabled",
  "capabilities": {
    "snapshot": "host.terminals.read"
  },
  "contract": "host.terminals.v1",
  "limits": {
    "max_containers_per_tab": 32,
    "max_members_per_container": 64,
    "max_response_bytes": 65536,
    "max_terminals_per_tab": 32
  },
  "methods": [
    "terminals.snapshot"
  ],
  "schemas": {
    "snapshot": {
      "$defs": {
        "HostTerminalLayoutItemV1": {
          "oneOf": [
            {
              "properties": {
                "kind": {
                  "const": "tiled",
                  "type": "string"
                },
                "terminal_id": {
                  "$ref": "#/schemas/snapshot/$defs/TerminalId"
                }
              },
              "required": [
                "kind",
                "terminal_id"
              ],
              "type": "object"
            },
            {
              "properties": {
                "container_id": {
                  "type": "string"
                },
                "kind": {
                  "const": "container",
                  "type": "string"
                },
                "selected_terminal_id": {
                  "anyOf": [
                    {
                      "$ref": "#/schemas/snapshot/$defs/TerminalId"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "terminal_ids": {
                  "items": {
                    "$ref": "#/schemas/snapshot/$defs/TerminalId"
                  },
                  "type": "array"
                }
              },
              "required": [
                "kind",
                "container_id",
                "terminal_ids"
              ],
              "type": "object"
            }
          ]
        },
        "HostTerminalsLeaseFenceV1": {
          "properties": {
            "artifact_generation": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "catalog_generation": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "package_generation": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "provider_generation": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "runtime_generation": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "service_generation": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "catalog_generation",
            "package_generation",
            "service_generation",
            "artifact_generation",
            "provider_generation",
            "runtime_generation"
          ],
          "type": "object"
        },
        "TabId": {
          "description": "Stable opaque identity for a server-owned tab.\n\nThis identity is independent from the generation-1 public\n`workspace:t<number>` handle, display order, and label.",
          "type": "string"
        },
        "TerminalId": {
          "description": "Stable opaque identity for a server-owned logical terminal.\n\nA terminal may move between panes or survive a server handoff without\nchanging this identity. Pane and layout identities must never be used as a\nsubstitute at public runtime boundaries.",
          "type": "string"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "contract": {
          "const": "host.terminals.v1",
          "type": "string"
        },
        "fingerprint_sha256": {
          "type": "string"
        },
        "layout": {
          "items": {
            "$ref": "#/schemas/snapshot/$defs/HostTerminalLayoutItemV1"
          },
          "type": "array"
        },
        "lease_fence": {
          "$ref": "#/schemas/snapshot/$defs/HostTerminalsLeaseFenceV1"
        },
        "tab_id": {
          "$ref": "#/schemas/snapshot/$defs/TabId"
        },
        "workspace_id": {
          "type": "string"
        }
      },
      "required": [
        "contract",
        "workspace_id",
        "tab_id",
        "lease_fence",
        "fingerprint_sha256",
        "layout"
      ],
      "title": "HostTerminalsSnapshotV1",
      "type": "object"
    },
    "snapshot_params": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "contract": {
          "const": "host.terminals.v1",
          "type": "string"
        }
      },
      "required": [
        "contract"
      ],
      "title": "HostTerminalsSnapshotParamsV1",
      "type": "object"
    }
  },
  "title": "staged read-only host terminals contract v1"
}
